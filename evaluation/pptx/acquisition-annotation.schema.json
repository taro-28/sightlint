{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightlint:evaluation:pptx-acquisition:0.1.0",
  "title": "SightLint PPTX acquisition annotations 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["annotationVersion", "kind", "provenance", "annotations"],
  "properties": {
    "annotationVersion": { "const": "0.1.0" },
    "kind": { "const": "acquisitionGroundTruth" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "annotations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "caseId", "slide", "nodes", "render", "abstentions"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "caseId": { "$ref": "#/$defs/id" },
          "slide": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "index", "part", "nativeId", "widthEmu", "heightEmu", "evidenceClass"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "index": { "const": 1 },
              "part": { "const": "ppt/slides/slide1.xml" },
              "nativeId": { "const": 256 },
              "widthEmu": { "type": "integer", "minimum": 1 },
              "heightEmu": { "type": "integer", "minimum": 1 },
              "evidenceClass": { "const": "exactSource" }
            }
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "nativeId", "nativeType", "zOrder", "geometryStatus", "sourceEvidenceClass", "text"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "nativeId": { "type": "integer", "minimum": 1 },
                "nativeType": { "enum": ["shape", "group"] },
                "zOrder": { "type": "integer", "minimum": 0 },
                "parentId": { "type": "string", "minLength": 1 },
                "geometryStatus": { "enum": ["exact", "unsupportedTransform", "missing"] },
                "sourceEvidenceClass": { "const": "exactSource" },
                "rectEmu": { "$ref": "#/$defs/rect" },
                "text": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status"],
                  "properties": {
                    "status": { "enum": ["absent", "digestOnly"] },
                    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                    "utf8Bytes": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          },
          "render": {
            "type": "object",
            "additionalProperties": false,
            "required": ["widthPixels", "heightPixels", "emuPerPixel", "extentReconciliation", "evidenceClass", "nodeIdentity"],
            "properties": {
              "widthPixels": { "type": "integer", "minimum": 1 },
              "heightPixels": { "type": "integer", "minimum": 1 },
              "emuPerPixel": { "type": "integer", "minimum": 1 },
              "extentReconciliation": { "enum": ["agreement", "conflict"] },
              "evidenceClass": { "const": "exactRender" },
              "nodeIdentity": { "const": "cantTell" }
            }
          },
          "abstentions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoringMethod", "implementationOutputUsed", "reviewer", "guideVersion"],
      "properties": {
        "authoringMethod": { "const": "fixtureSpecification" },
        "implementationOutputUsed": { "const": false },
        "reviewer": { "const": "maintainerOnly" },
        "guideVersion": { "const": "0.1.0" }
      }
    }
  }
}
