{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightlint:evaluation:pdf-acquisition:0.1.0",
  "title": "SightLint PDF acquisition annotations 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["annotationVersion", "kind", "provenance", "annotations"],
  "properties": {
    "annotationVersion": { "const": "0.1.0" },
    "kind": { "const": "acquisitionGroundTruth" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "annotations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "caseId", "pdfHeader", "taggedStructure", "page", "annotations", "render", "abstentions"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "caseId": { "$ref": "#/$defs/id" },
          "pdfHeader": { "const": "%PDF-1.7" },
          "taggedStructure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["catalogDeclaresStructTreeRoot", "interpretation"],
            "properties": {
              "catalogDeclaresStructTreeRoot": { "type": "boolean" },
              "interpretation": { "const": "untested" }
            }
          },
          "page": { "$ref": "#/$defs/page" },
          "annotations": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/annotation" }
          },
          "render": { "$ref": "#/$defs/render" },
          "abstentions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "objectReference": { "type": "string", "pattern": "^(0|[1-9][0-9]*) (0|[1-9][0-9]*) R$" },
    "sourceRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "bottom", "right", "top"],
      "properties": {
        "left": { "type": "integer" },
        "bottom": { "type": "integer" },
        "right": { "type": "integer" },
        "top": { "type": "integer" }
      }
    },
    "normalizedRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "objectReference", "rotationDegrees", "geometryStatus", "mediaBoxPdfPoints", "cropBoxPdfPoints", "evidenceClass"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "index": { "const": 1 },
        "objectReference": { "$ref": "#/$defs/objectReference" },
        "rotationDegrees": { "const": 0 },
        "geometryStatus": { "const": "exact" },
        "mediaBoxPdfPoints": { "$ref": "#/$defs/sourceRect" },
        "cropBoxPdfPoints": { "$ref": "#/$defs/sourceRect" },
        "evidenceClass": { "const": "exactSource" }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objectReference", "subtype", "flags", "hasQuadPoints", "hasPath", "actionKind", "geometryStatus", "sourceRectPdfPoints", "sourceEvidenceClass"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "objectReference": { "$ref": "#/$defs/objectReference" },
        "subtype": { "const": "/Link" },
        "flags": { "const": 0 },
        "hasQuadPoints": { "type": "boolean" },
        "hasPath": { "const": false },
        "actionKind": { "const": "internalDestination" },
        "geometryStatus": { "enum": ["exact", "unsupportedQuadPoints"] },
        "sourceRectPdfPoints": { "$ref": "#/$defs/sourceRect" },
        "normalizedHitBoxPdfPoints": { "$ref": "#/$defs/normalizedRect" },
        "sourceEvidenceClass": { "const": "exactSource" }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthPixels", "heightPixels", "pdfPointsPerPixel", "extentReconciliation", "evidenceClass", "nodeIdentity"],
      "properties": {
        "widthPixels": { "type": "integer", "minimum": 1 },
        "heightPixels": { "type": "integer", "minimum": 1 },
        "pdfPointsPerPixel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": { "const": 1 },
            "denominator": { "const": 1 }
          }
        },
        "extentReconciliation": { "const": "agreement" },
        "evidenceClass": { "const": "exactRender" },
        "nodeIdentity": { "const": "cantTell" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoringMethod", "implementationOutputUsed", "reviewer", "guideVersion"],
      "properties": {
        "authoringMethod": { "const": "fixtureSpecification" },
        "implementationOutputUsed": { "const": false },
        "reviewer": { "const": "maintainerOnly" },
        "guideVersion": { "const": "0.1.0" }
      }
    }
  }
}
