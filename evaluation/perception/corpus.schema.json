{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightlint:schema:perception-evaluation-corpus:0.1.0",
  "title": "SightLint perception evaluation corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "corpus", "source", "governance", "protocol", "annotations", "splitPolicy", "gates", "cases"],
  "properties": {
    "$schema": { "const": "./corpus.schema.json" },
    "schemaVersion": { "const": "0.1.0" },
    "corpus": { "$ref": "#/$defs/corpus" },
    "source": { "$ref": "#/$defs/source" },
    "governance": { "$ref": "#/$defs/governance" },
    "protocol": { "$ref": "#/$defs/protocol" },
    "annotations": { "$ref": "#/$defs/annotations" },
    "splitPolicy": { "$ref": "#/$defs/splitPolicy" },
    "gates": { "$ref": "#/$defs/gates" },
    "cases": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "token": { "type": "string", "pattern": "^[a-z0-9][a-zA-Z0-9.-]*$" },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "corpus": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scope", "limitations"],
      "properties": {
        "id": { "$ref": "#/$defs/token" }, "scope": { "$ref": "#/$defs/text" },
        "limitations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "origin", "license", "privacyReview", "externalAssets", "fictionalData"],
      "properties": {
        "kind": { "const": "repositoryOwnedWebFixture" }, "origin": { "$ref": "#/$defs/path" },
        "license": { "const": "MIT OR Apache-2.0" }, "privacyReview": { "const": "syntheticNoPersonalData" },
        "externalAssets": { "const": false }, "fictionalData": { "const": true }
      }
    },
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["annotationAuthor", "implementationOutputIsGroundTruth", "capturedArtifactsCommitted", "externalProcessing", "telemetryCollected", "holdoutStatus"],
      "properties": {
        "annotationAuthor": { "const": "maintainerSourceReview" }, "implementationOutputIsGroundTruth": { "const": false },
        "capturedArtifactsCommitted": { "const": false }, "externalProcessing": { "const": false },
        "telemetryCollected": { "const": false }, "holdoutStatus": { "const": "notEstablished" }
      }
    },
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["requestSchema", "responseSchema", "runReportSchema", "extensionSchema", "version", "referenceWorker"],
      "properties": {
        "requestSchema": { "$ref": "#/$defs/path" }, "responseSchema": { "$ref": "#/$defs/path" },
        "runReportSchema": { "$ref": "#/$defs/path" }, "extensionSchema": { "$ref": "#/$defs/path" },
        "version": { "const": "0.1.0" }, "referenceWorker": { "const": "sightlint-reference-region-worker@0.1.0" }
      }
    },
    "annotations": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "acquisition", "rules", "nativeAcquisitionSource", "nativeRuleSource"],
      "properties": {
        "schema": { "$ref": "#/$defs/path" }, "acquisition": { "$ref": "#/$defs/path" },
        "rules": { "$ref": "#/$defs/path" }, "nativeAcquisitionSource": { "$ref": "#/$defs/path" },
        "nativeRuleSource": { "$ref": "#/$defs/path" }
      }
    },
    "splitPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["smoke", "development", "challenge", "holdout"],
      "properties": {
        "smoke": { "$ref": "#/$defs/text" }, "development": { "$ref": "#/$defs/text" },
        "challenge": { "$ref": "#/$defs/text" },
        "holdout": {
          "type": "object", "additionalProperties": false, "required": ["status", "reason"],
          "properties": { "status": { "const": "notEstablished" }, "reason": { "$ref": "#/$defs/text" } }
        }
      }
    },
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": ["determinismRuns", "maximumBlockingFindings", "maximumSemanticClaims", "requiredAcquisitionMutationObservations", "requiredHardNegativeFailures"],
      "properties": {
        "determinismRuns": { "const": 2 }, "maximumBlockingFindings": { "const": 0 },
        "maximumSemanticClaims": { "const": 0 }, "requiredAcquisitionMutationObservations": { "const": 1 },
        "requiredHardNegativeFailures": { "const": 0 }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "split", "classification", "request"],
      "properties": {
        "id": { "$ref": "#/$defs/token" }, "split": { "enum": ["smoke", "development", "challenge"] },
        "classification": { "enum": ["clean", "targetedMutation", "hardNegative"] },
        "request": { "$ref": "#/$defs/path" }, "baselineCaseId": { "$ref": "#/$defs/token" }
      }
    }
  }
}
