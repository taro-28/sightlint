{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightlint:evaluation:android-metric-contract:0.1.0",
  "title": "SightLint Android metric contract 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["corpusVersion", "implementationOutputsStoredAsOracle", "metrics", "nonClaim"],
  "properties": {
    "corpusVersion": { "const": "0.1.0" },
    "implementationOutputsStoredAsOracle": { "const": false },
    "metrics": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "numerator", "denominator"],
        "properties": {
          "id": { "enum": ["acquisitionFactCoverage", "evaluatedCaseCoverage", "failurePrecision", "abstentionRetention", "falsePositiveRate", "mutationKillRate"] },
          "numerator": { "$ref": "#/$defs/nonEmptyString" },
          "denominator": { "$ref": "#/$defs/nonEmptyString" },
          "requiredMinimum": { "type": "number", "minimum": 0, "maximum": 1 },
          "requiredMaximum": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "oneOf": [
          {
            "required": ["requiredMinimum"],
            "properties": {
              "requiredMinimum": {},
              "requiredMaximum": false
            }
          },
          {
            "required": ["requiredMaximum"],
            "properties": {
              "requiredMinimum": false,
              "requiredMaximum": {}
            }
          }
        ]
      }
    },
    "nonClaim": { "$ref": "#/$defs/nonEmptyString" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "maxLength": 1024 }
  }
}
