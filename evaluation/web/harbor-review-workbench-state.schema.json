{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightlint:schema:harbor-review-workbench-state:1.0.0",
  "title": "SightLint local Harbor review workbench state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "documentType",
    "stateDigest",
    "recordPurpose",
    "questionnaireBinding",
    "packetBinding",
    "submissionId",
    "reviewer",
    "confirmations",
    "answers",
    "stateLimitations"
  ],
  "properties": {
    "$schema": { "const": "./harbor-review-workbench-state.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "documentType": { "const": "harborReviewWorkbenchState" },
    "stateDigest": { "$ref": "#/$defs/sha256" },
    "recordPurpose": { "enum": ["fictionalConformance", "humanReviewCandidate"] },
    "questionnaireBinding": { "$ref": "#/$defs/questionnaireBinding" },
    "packetBinding": { "$ref": "#/$defs/packetBinding" },
    "submissionId": { "$ref": "#/$defs/draftText" },
    "reviewer": { "$ref": "#/$defs/reviewer" },
    "confirmations": { "$ref": "#/$defs/confirmations" },
    "answers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/answer" }
    },
    "stateLimitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/text" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "draftText": { "type": "string", "maxLength": 4096 },
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "idList": {
      "type": "array",
      "maxItems": 27,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "questionnaireBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionnaireId", "questionnaireDigest"],
      "properties": {
        "questionnaireId": { "$ref": "#/$defs/id" },
        "questionnaireDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "packetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packetId", "packetDigest"],
      "properties": {
        "packetId": { "$ref": "#/$defs/id" },
        "packetDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableProjectId",
        "qualificationCategory",
        "qualificationRationale",
        "independence",
        "independenceRationale",
        "priorExposureStatus",
        "priorExposureCaseIds",
        "priorExposureRationale",
        "conflictStatus",
        "conflictRationale",
        "reviewedOn"
      ],
      "properties": {
        "stableProjectId": { "$ref": "#/$defs/draftText" },
        "qualificationCategory": {
          "type": ["string", "null"],
          "enum": [null, "accessibility", "other", "productReview", "webUi"]
        },
        "qualificationRationale": { "$ref": "#/$defs/draftText" },
        "independence": {
          "type": ["string", "null"],
          "enum": [null, "declaredFalse", "declaredTrue"]
        },
        "independenceRationale": { "$ref": "#/$defs/draftText" },
        "priorExposureStatus": {
          "type": ["string", "null"],
          "enum": [null, "full", "none", "partial"]
        },
        "priorExposureCaseIds": { "$ref": "#/$defs/idList" },
        "priorExposureRationale": { "$ref": "#/$defs/draftText" },
        "conflictStatus": {
          "type": ["string", "null"],
          "enum": [null, "declared", "noneDeclared"]
        },
        "conflictRationale": { "$ref": "#/$defs/draftText" },
        "reviewedOn": { "type": "string", "maxLength": 10 }
      }
    },
    "confirmations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceFirstNotBlind",
        "sightlintOutputNotUsed",
        "existingOracleNotViewed",
        "generatedCaptureNotUsed",
        "implementationOutputNotUsed",
        "noPrivateData",
        "noCredentials",
        "noExternalProcessing",
        "cleanLocalBrowserProfile"
      ],
      "properties": {
        "sourceFirstNotBlind": { "type": "boolean" },
        "sightlintOutputNotUsed": { "type": "boolean" },
        "existingOracleNotViewed": { "type": "boolean" },
        "generatedCaptureNotUsed": { "type": "boolean" },
        "implementationOutputNotUsed": { "type": "boolean" },
        "noPrivateData": { "type": "boolean" },
        "noCredentials": { "type": "boolean" },
        "noExternalProcessing": { "type": "boolean" },
        "cleanLocalBrowserProfile": { "type": "boolean" }
      }
    },
    "acquisitionAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observedValueKind", "value", "confidence", "rationale"],
      "properties": {
        "status": {
          "type": ["string", "null"],
          "enum": [null, "cantTell", "observed", "untested"]
        },
        "observedValueKind": {
          "type": ["string", "null"],
          "enum": [null, "absent", "text"]
        },
        "value": { "type": ["string", "null"], "maxLength": 4096 },
        "confidence": {
          "type": ["string", "null"],
          "enum": [null, "high", "low", "medium"]
        },
        "rationale": { "$ref": "#/$defs/draftText" }
      }
    },
    "ruleAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "requiredEvidence", "confidence", "rationale"],
      "properties": {
        "outcome": {
          "type": ["string", "null"],
          "enum": [null, "cantTell", "failed", "inapplicable", "passed", "untested"]
        },
        "requiredEvidence": {
          "type": ["string", "null"],
          "enum": [null, "conflicting", "insufficient", "sufficient", "untested"]
        },
        "confidence": {
          "type": ["string", "null"],
          "enum": [null, "high", "low", "medium"]
        },
        "rationale": { "$ref": "#/$defs/draftText" }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "acquisition", "rule"],
      "properties": {
        "caseId": { "$ref": "#/$defs/id" },
        "acquisition": { "$ref": "#/$defs/acquisitionAnswer" },
        "rule": { "$ref": "#/$defs/ruleAnswer" }
      }
    }
  }
}
