{
  "$schema": "../browser-rule.schema.json",
  "schemaVersion": "0.2.0",
  "documentType": "browserRuleOracle",
  "commandSurface": "sightlint check --profile recommended --format json",
  "profiles": ["sightlint:base", "sightlint:recommended"],
  "ruleContracts": [
    {
      "ruleId": "web.accessibility.interactive-name",
      "ruleVersion": "0.1.0",
      "maturity": "advisory",
      "enforcement": "advisory",
      "policy": {
        "profile": "sightlint:recommended",
        "sourceKind": "platformStandard",
        "sourceId": "wcag:4.1.2-name-role-value",
        "sourceVersion": "2.2",
        "reference": "https://www.w3.org/TR/WCAG22/#name-role-value"
      },
      "applicability": "Visible DOM-interactive Web nodes with an observed platform accessibility role in the conservative supported control set.",
      "requiredEvidence": [
        "exact DOM interactivity and visibility",
        "platform accessibility role and name"
      ],
      "validAlternatives": [
        "visible text content",
        "aria-label",
        "aria-labelledby",
        "another platform-supported accessible-name source"
      ],
      "severityInputs": {
        "userHarm": "An unnamed send control can be undiscoverable or ambiguous to assistive-technology users.",
        "affectedScope": "One observed reply action in one captured support-inbox state.",
        "reversibility": "The local semantic label has several valid reversible implementations.",
        "accessibilityImpact": "Direct programmatic-name impact; this evaluation does not derive a severity label."
      },
      "falsePositiveRisks": [
        "an incomplete platform accessibility snapshot may appear unnamed",
        "requiring aria-label specifically would reject valid alternative naming sources"
      ],
      "falseNegativeRisks": [
        "a non-empty but misleading or duplicate name passes this atomic rule",
        "unselected controls and unsupported platform roles abstain rather than fail"
      ],
      "evaluationCases": {
        "pass": ["support-inbox-clean"],
        "fail": ["support-inbox-unnamed-control"],
        "cantTell": ["support-inbox-ambiguous-control"],
        "inapplicable": ["support-inbox-clean"],
        "hardNegative": ["support-inbox-labelledby-hard-negative"]
      }
    }
  ],
  "metrics": {
    "failurePrecision": "Count matched reviewed failed results over all emitted failed results for this family and split.",
    "caseCoverage": "Count executed reviewed cases over all registered cases for this family and split.",
    "abstention": "Count matched reviewed cantTell, inapplicable, and untested results over reviewed abstention results.",
    "falsePositives": "Count emitted failed results absent from the separate reviewed rule oracle, including hard-negative failures.",
    "mutationKillRate": "Count targeted rule-eligible mutations emitting the reviewed failure over all targeted rule-eligible mutations.",
    "limitations": [
      "Four public cases in one repository-owned family are regression evidence, not representative precision or recall.",
      "The labels are visible to implementers and are not protected holdout data.",
      "Review is maintainer-only and does not establish independent reviewer agreement.",
      "Only programmatic-name presence for one selected control is evaluated; complete WCAG or UI and UX quality is not."
    ]
  },
