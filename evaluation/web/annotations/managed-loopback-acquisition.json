        { "aspect": "web.capture.sourceDigestMatchesResponse", "operator": "equals", "value": true },
        { "aspect": "lifecycle.directPortReleased", "operator": "equals", "value": true }
      ],
      "abstentions": [
        {
          "aspect": "screenshot.pixelContentIdentity",
          "outcome": "cantTell",
          "rationale": "The synchronized screenshot records extent and bytes but protocol 0.2.0 performs no pixel-content identity comparison."
        },
        {
          "aspect": "web.completeHitRegions",
          "outcome": "cantTell",
          "rationale": "Center hit samples are exact observations but are not complete hit rectangles."
