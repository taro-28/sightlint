{
  "$schema": "./corpus.schema.json",
  "schemaVersion": "0.1.0",
  "corpus": {
    "id": "sightlint-realistic-web-foundation",
    "version": "0.1.0",
    "description": "Repository-owned Web UI cases with separate acquisition and rule ground truth.",
    "scope": "Evaluation-contract foundation for one explicit peer-spacing rule and future Web acquisition.",
    "limitations": [
      "One fictional dashboard application is not representative of real-world Web UI diversity.",
      "Browser, accessibility, computed-geometry, screenshot, and reconciliation acquisition are untested until issue 23.",
      "Runnable rule inputs contain reviewed declared geometry and are not evidence of adapter accuracy.",
      "All labels are visible development data and none are a frozen holdout.",
      "The evaluated rule remains experimental and nonblocking in this corpus."
    ]
  },
  "annotationGuide": {
    "version": "0.1.0",
    "path": "evaluation/web/annotation-guide.md"
  },
  "sources": [
    {
      "id": "atlas-dashboard-repository-fixture-v0",
      "kind": "repositoryOwnedFixture",
      "origin": "evaluation/web/fixture-app",
      "ownership": "sightlintRepository",
      "license": "MIT OR Apache-2.0",
      "redistribution": "Redistribution permitted under MIT OR Apache-2.0.",
      "privacyReview": "syntheticNoPersonalData",
      "externalAssets": false
    }
  ],
  "splitPolicy": {
    "smoke": "Required public cases that protect the reviewed rule projection and hard-negative behavior.",
    "development": "Public cases available to design and tune the future Web adapter and rules.",
    "holdout": {
      "status": "notEstablished",
      "reason": "A public corpus with visible labels cannot provide a secret holdout.",
      "requiredBeforeUse": [
        "Record a freeze commit before tuning begins.",
        "Define who can access artifacts and labels.",
        "Use an independent evaluator or disclose every exposure.",
        "Define a reviewed oracle-correction process.",
        "Publish split-specific metrics and sampling limitations."
      ]
    },
    "challenge": "Public hard negatives and unusual valid layouts; challenge cases are not secret holdout data."
  },
  "gates": {
    "smoke": {
      "determinismRuns": 2,
      "requireAllExpectations": true,
      "requireAllMutationsKilled": true,
      "maximumFalsePositives": 0
    }
  },
