{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightlint:schema:web-browser-rule-oracle:0.2.0",
  "title": "SightLint reviewed browser rule oracle",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "documentType", "commandSurface", "profiles", "ruleContracts", "metrics", "cases"],
  "properties": {
    "$schema": { "const": "../browser-rule.schema.json" },
    "schemaVersion": { "const": "0.2.0" },
    "documentType": { "const": "browserRuleOracle" },
    "commandSurface": { "const": "sightlint check --profile recommended --format json" },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["sightlint:base", "sightlint:recommended"] }
    },
    "ruleContracts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ruleContract" } },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failurePrecision", "caseCoverage", "abstention", "falsePositives", "mutationKillRate", "limitations"],
      "properties": {
        "failurePrecision": { "$ref": "#/$defs/nonEmptyString" },
        "caseCoverage": { "$ref": "#/$defs/nonEmptyString" },
        "abstention": { "$ref": "#/$defs/nonEmptyString" },
        "falsePositives": { "$ref": "#/$defs/nonEmptyString" },
        "mutationKillRate": { "$ref": "#/$defs/nonEmptyString" },
        "limitations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._/-]+$" },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewedAt", "qualification", "rationale"],
      "properties": {
        "status": { "enum": ["maintainerReviewed", "dualReviewed", "expertReviewed"] },
        "reviewedAt": { "type": "string", "format": "date" },
        "qualification": { "$ref": "#/$defs/nonEmptyString" },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "sourceKind", "sourceId", "sourceVersion", "reference"],
      "properties": {
        "profile": { "enum": ["sightlint:base", "sightlint:recommended"] },
        "sourceKind": { "enum": ["declaredContract", "platformStandard", "conservativeBuiltIn"] },
        "sourceId": { "$ref": "#/$defs/nonEmptyString" },
        "sourceVersion": { "$ref": "#/$defs/nonEmptyString" },
        "reference": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "ruleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "ruleVersion", "maturity", "enforcement", "policy", "applicability", "requiredEvidence", "validAlternatives", "severityInputs", "falsePositiveRisks", "falseNegativeRisks", "evaluationCases"],
      "properties": {
        "ruleId": { "$ref": "#/$defs/nonEmptyString" },
        "ruleVersion": { "$ref": "#/$defs/nonEmptyString" },
        "maturity": { "const": "advisory" },
        "enforcement": { "const": "advisory" },
        "policy": { "$ref": "#/$defs/policy" },
        "applicability": { "$ref": "#/$defs/nonEmptyString" },
        "requiredEvidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "validAlternatives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "severityInputs": { "$ref": "#/$defs/severityInputs" },
        "falsePositiveRisks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "falseNegativeRisks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "evaluationCases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass", "fail", "cantTell", "inapplicable", "hardNegative"],
          "properties": {
            "pass": { "$ref": "#/$defs/caseIds" },
            "fail": { "$ref": "#/$defs/caseIds" },
            "cantTell": { "$ref": "#/$defs/caseIds" },
            "inapplicable": { "$ref": "#/$defs/caseIds" },
            "hardNegative": { "$ref": "#/$defs/caseIds" }
          }
        }
      }
    },
    "severityInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userHarm", "affectedScope", "reversibility", "accessibilityImpact"],
      "properties": {
        "userHarm": { "$ref": "#/$defs/nonEmptyString" },
        "affectedScope": { "$ref": "#/$defs/nonEmptyString" },
        "reversibility": { "$ref": "#/$defs/nonEmptyString" },
        "accessibilityImpact": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "caseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "expectedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "ruleVersion", "maturity", "enforcement", "policy", "outcome", "targetKind", "targetId", "targetAspect"],
      "properties": {
        "ruleId": { "$ref": "#/$defs/nonEmptyString" },
        "ruleVersion": { "$ref": "#/$defs/nonEmptyString" },
        "maturity": { "enum": ["experimental", "advisory", "blockingEligible"] },
        "enforcement": { "enum": ["advisory", "blocking"] },
        "policy": { "$ref": "#/$defs/policy" },
        "outcome": { "enum": ["passed", "failed", "cantTell", "inapplicable", "untested"] },
        "targetKind": { "$ref": "#/$defs/nonEmptyString" },
        "targetId": { "$ref": "#/$defs/nonEmptyString" },
        "targetAspect": { "type": ["string", "null"] }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "request", "classification", "expectedExitCode", "expectedFailureCount", "expectedBlockingFailureCount", "expectedResults", "falsePositiveRisk", "nonClaim", "review"],
      "properties": {
        "caseId": { "$ref": "#/$defs/nonEmptyString" },
        "request": { "$ref": "#/$defs/relativePath" },
        "classification": { "enum": ["clean", "targetedMutation", "hardNegative", "ambiguous"] },
        "expectedExitCode": { "enum": [0, 1] },
        "expectedFailureCount": { "type": "integer", "minimum": 0 },
        "expectedBlockingFailureCount": { "type": "integer", "minimum": 0 },
        "expectedResults": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expectedResult" } },
        "falsePositiveRisk": { "$ref": "#/$defs/nonEmptyString" },
        "nonClaim": { "$ref": "#/$defs/nonEmptyString" },
        "review": { "$ref": "#/$defs/review" }
      }
    }
  }
}
