{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightlint:schema:managed-loopback-evaluation:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provenance",
    "split",
    "cases",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "owner",
        "license",
        "privacy",
        "implementationOutputUsedAsOracle",
        "externalProcessing"
      ],
      "properties": {
        "source": {
          "const": "repositoryOwnedAtlasFixture"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "const": "MIT OR Apache-2.0"
        },
        "privacy": {
          "const": "fictionalDataNoSecrets"
        },
        "implementationOutputUsedAsOracle": {
          "const": false
        },
        "externalProcessing": {
          "const": false
        }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "holdoutStatus",
        "reviewer",
        "independentReview"
      ],
      "properties": {
        "kind": {
          "const": "publicSmokeDevelopmentChallenge"
        },
        "holdoutStatus": {
          "const": "notHoldout"
        },
        "reviewer": {
          "const": "maintainer"
        },
        "independentReview": {
          "const": false
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "request",
          "classification",
          "expectedFailureCount",
          "expectedResult"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "request": {
            "type": "string",
            "pattern": "^evaluation/web/managed-requests/"
          },
          "classification": {
            "enum": [
              "clean",
              "targetedMutation",
              "hardNegative"
            ]
          },
          "expectedFailureCount": {
            "type": "integer",
            "minimum": 0
          },
          "expectedResult": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/result"
              }
            ]
          }
        }
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "ruleVersion",
        "outcome",
        "enforcement",
        "targetKind",
        "targetId"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "ruleVersion": {
          "const": "0.1.0"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "cantTell",
            "inapplicable",
            "untested"
          ]
        },
        "enforcement": {
          "enum": [
            "advisory",
            "blocking"
          ]
        },
        "targetKind": {
          "enum": [
            "artifact",
            "canvas",
            "node",
            "relation"
          ]
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
