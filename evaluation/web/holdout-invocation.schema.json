{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightlint:schema:web-holdout-invocation:1.0.0",
  "title": "SightLint protected Web holdout invocation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "documentType",
    "manifestDigest",
    "dataClassification",
    "source",
    "bundleBinding",
    "oracleBinding",
    "commands",
    "environment",
    "resourceLimits",
    "createdAt",
    "createdBy"
  ],
  "properties": {
    "$schema": { "const": "urn:sightlint:schema:web-holdout-invocation:1.0.0" },
    "schemaVersion": { "const": "1.0.0" },
    "documentType": { "const": "protectedHoldoutInvocationManifest" },
    "manifestDigest": { "$ref": "#/$defs/sha256" },
    "dataClassification": { "enum": ["protectedHoldout", "publicConformanceOnly"] },
    "source": { "$ref": "#/$defs/source" },
    "bundleBinding": { "$ref": "#/$defs/versionedBinding" },
    "oracleBinding": { "$ref": "#/$defs/versionedBinding" },
    "commands": { "$ref": "#/$defs/commands" },
    "environment": { "$ref": "#/$defs/environment" },
    "resourceLimits": { "$ref": "#/$defs/resourceLimits" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "createdBy": { "$ref": "#/$defs/id" }
  },
  "$defs": {
    "ascii": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[ -~]+$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "git": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "versionedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifestDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "manifestDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "buildInputArchiveDigest",
        "binaryDigest",
        "adapterLockDigest",
        "adapterEntryDigest"
      ],
      "properties": {
        "commit": { "$ref": "#/$defs/git" },
        "tree": { "$ref": "#/$defs/git" },
        "buildInputArchiveDigest": { "$ref": "#/$defs/sha256" },
        "binaryDigest": { "$ref": "#/$defs/sha256" },
        "adapterLockDigest": { "$ref": "#/$defs/sha256" },
        "adapterEntryDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/ascii" }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandDigest", "allowedPlaceholders", "captureArgv", "checkArgv", "shellInterpolation"],
      "properties": {
        "commandDigest": { "$ref": "#/$defs/sha256" },
        "allowedPlaceholders": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "enum": ["{request}", "{repositoryRoot}", "{artifactIr}", "{screenshot}"] }
        },
        "captureArgv": { "$ref": "#/$defs/argv" },
        "checkArgv": { "$ref": "#/$defs/argv" },
        "shellInterpolation": { "const": false }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestDigest",
        "operatingSystem",
        "architecture",
        "rustVersion",
        "nodeVersion",
        "playwrightVersion",
        "chromiumRevision",
        "locale",
        "timezone",
        "theme",
        "reducedMotion",
        "viewportWidthCssPixels",
        "viewportHeightCssPixels",
        "deviceScaleFactor",
        "textScale"
      ],
      "properties": {
        "manifestDigest": { "$ref": "#/$defs/sha256" },
        "operatingSystem": { "enum": ["linux", "macos", "windows"] },
        "architecture": { "$ref": "#/$defs/ascii" },
        "rustVersion": { "$ref": "#/$defs/ascii" },
        "nodeVersion": { "$ref": "#/$defs/ascii" },
        "playwrightVersion": { "$ref": "#/$defs/ascii" },
        "chromiumRevision": { "$ref": "#/$defs/ascii" },
        "locale": { "$ref": "#/$defs/ascii" },
        "timezone": { "$ref": "#/$defs/ascii" },
        "theme": { "enum": ["light", "dark"] },
        "reducedMotion": { "enum": ["reduce", "no-preference"] },
        "viewportWidthCssPixels": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "viewportHeightCssPixels": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "deviceScaleFactor": { "type": "integer", "minimum": 1, "maximum": 8 },
        "textScale": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumCases", "maximumCaseSeconds", "maximumOutputBytes", "maximumManifestBytes"],
      "properties": {
        "maximumCases": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "maximumCaseSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "maximumOutputBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "maximumManifestBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    }
  }
}
