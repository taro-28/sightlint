{
  "$schema": "../../../adapters/playwright/schemas/capture-request.schema.json",
  "protocolVersion": "0.1.0",
  "artifact": { "id": "web-dashboard-browser-text-scale", "title": "Atlas dashboard — 125 percent text scale" },
  "fixture": {
    "entrypoint": "evaluation/web/fixture-app/index.html",
    "state": "peer-spacing-clean",
    "readinessSelector": "html[data-fixture-ready=\"true\"]"
  },
  "environment": {
    "viewport": { "width": 1280, "height": 800, "unit": "cssPixel" },
    "deviceScaleFactor": 1,
    "textScale": 1.25,
    "locale": "en-US",
    "timezoneId": "UTC",
    "colorScheme": "light",
    "reducedMotion": "reduce"
  },
  "privacy": { "accessibleNameMode": "selectedNodes", "externalProcessing": false },
  "network": { "mode": "deny" },
  "screenshot": { "reference": "capture/dashboard-browser-text-scale.png" }
}
