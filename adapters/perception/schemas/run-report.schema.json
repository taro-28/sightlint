{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightlint:schema:perception-run-report:0.1.0",
  "title": "SightLint perception run report",
  "type": "object",
  "additionalProperties": false,
  "required": ["runSchemaVersion", "protocolVersion", "requestId", "status", "blocking", "ruleOutcome", "requestSha256", "workerResponse", "artifactIr", "familyStatus", "resourceUse", "limitations"],
  "properties": {
    "runSchemaVersion": { "const": "0.1.0" }, "protocolVersion": { "const": "0.1.0" },
    "requestId": { "$ref": "#/$defs/token" }, "status": { "enum": ["complete", "partial", "unsupported", "ambiguous"] },
    "blocking": { "const": false }, "ruleOutcome": { "const": "untested" }, "requestSha256": { "$ref": "#/$defs/sha256" },
    "workerResponse": { "$ref": "#/$defs/file" }, "artifactIr": { "$ref": "#/$defs/file" },
    "familyStatus": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/familyStatus" } },
    "resourceUse": {
      "type": "object", "additionalProperties": false,
      "required": ["requestBytes", "workerStdoutBytes", "workerStderrBytes", "observationCount", "timeoutMs"],
      "properties": {
        "requestBytes": { "type": "integer", "minimum": 2 }, "workerStdoutBytes": { "type": "integer", "minimum": 2 },
        "workerStderrBytes": { "type": "integer", "minimum": 0 }, "observationCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "timeoutMs": { "type": "integer", "minimum": 50, "maximum": 30000 }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "token": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["reference", "sha256", "byteLength"],
      "properties": { "reference": { "$ref": "#/$defs/text" }, "sha256": { "$ref": "#/$defs/sha256" }, "byteLength": { "type": "integer", "minimum": 2 } }
    },
    "familyStatus": {
      "type": "object", "additionalProperties": false, "required": ["family", "status", "reason"],
      "properties": {
        "family": { "enum": ["hierarchy", "peerGroup", "region", "role", "text"] },
        "status": { "enum": ["observed", "partial", "unsupported", "ambiguous", "untested"] },
        "reason": { "$ref": "#/$defs/text" }
      }
    }
  }
}
