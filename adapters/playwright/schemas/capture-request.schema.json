{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightlint:schema:playwright-capture-request:0.1.0",
  "title": "SightLint Playwright capture request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocolVersion",
    "artifact",
    "fixture",
    "environment",
    "privacy",
    "network",
    "screenshot"
  ],
  "properties": {
    "$schema": { "const": "../../../adapters/playwright/schemas/capture-request.schema.json" },
    "protocolVersion": { "const": "0.1.0" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "state", "readinessSelector"],
      "properties": {
        "entrypoint": { "$ref": "#/$defs/repositoryPath" },
        "state": { "$ref": "#/$defs/token" },
        "readinessSelector": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewport",
        "deviceScaleFactor",
        "textScale",
        "locale",
        "timezoneId",
        "colorScheme",
        "reducedMotion"
      ],
      "properties": {
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "unit"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "height": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "unit": { "const": "cssPixel" }
          }
        },
        "deviceScaleFactor": { "type": "number", "minimum": 1, "maximum": 2 },
        "textScale": { "enum": [1, 1.25] },
        "locale": { "const": "en-US" },
        "timezoneId": { "const": "UTC" },
        "colorScheme": { "const": "light" },
        "reducedMotion": { "const": "reduce" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessibleNameMode", "externalProcessing"],
      "properties": {
        "accessibleNameMode": { "const": "selectedNodes" },
        "externalProcessing": { "const": false }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "const": "deny" }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference"],
      "properties": {
        "reference": { "$ref": "#/$defs/repositoryPath" }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "maxLength": 256 },
    "token": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 80 },
    "repositoryPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+$",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
