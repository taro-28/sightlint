{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightlint:schema:playwright-interaction-request:0.1.0",
  "title": "SightLint Playwright interaction request 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "protocolVersion", "artifact", "fixture", "action", "trace", "environment", "privacy", "network"],
  "properties": {
    "$schema": { "const": "../../../adapters/playwright/schemas/interaction-request.schema.json" },
    "protocolVersion": { "const": "0.1.0" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "state", "readinessSelector"],
      "properties": {
        "entrypoint": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "maxLength": 512 },
        "state": { "$ref": "#/$defs/token" },
        "readinessSelector": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targetTestId", "effectLatency", "recovery"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "targetTestId": { "$ref": "#/$defs/token" },
        "effectLatency": { "enum": ["immediate", "observable"] },
        "recovery": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["applicability"],
              "properties": { "applicability": { "const": "inapplicable" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["applicability", "acceptedAlternatives"],
              "properties": {
                "applicability": { "const": "required" },
                "acceptedAlternatives": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/recovery" }
                }
              }
            }
          ]
        }
      }
    },
    "trace": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "execution", "steps"],
          "properties": {
            "id": { "$ref": "#/$defs/token" },
            "execution": { "const": "captured" },
            "steps": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/step" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "execution", "reason", "steps"],
          "properties": {
            "id": { "$ref": "#/$defs/token" },
            "execution": { "const": "untested" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 256 },
            "steps": { "type": "array", "maxItems": 0 }
          }
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewport", "locale", "timezoneId", "colorScheme", "reducedMotion"],
      "properties": {
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "unit"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 2048 },
            "height": { "type": "integer", "minimum": 1, "maximum": 2048 },
            "unit": { "const": "cssPixel" }
          }
        },
        "locale": { "const": "en-US" },
        "timezoneId": { "const": "UTC" },
        "colorScheme": { "const": "light" },
        "reducedMotion": { "const": "reduce" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textMode", "externalProcessing"],
      "properties": {
        "textMode": { "const": "digestOnly" },
        "externalProcessing": { "const": false }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "const": "deny" } }
    }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 256 },
    "recovery": { "enum": ["retry", "saveDraft"] },
    "step": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["activate", "resolveSuccess", "reject"] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "recovery"], "properties": { "kind": { "const": "activateRecovery" }, "recovery": { "$ref": "#/$defs/recovery" } } }
      ]
    }
  }
}
