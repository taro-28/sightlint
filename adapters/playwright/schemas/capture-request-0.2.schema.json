{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightlint:schema:playwright-capture-request:0.2.0",
  "title": "SightLint managed loopback Playwright capture request",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "protocolVersion", "artifact", "target", "server", "environment", "privacy", "network", "screenshot"],
  "properties": {
    "$schema": { "const": "../../../adapters/playwright/schemas/capture-request-0.2.schema.json" },
    "protocolVersion": { "const": "0.2.0" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "title": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pathAndQuery", "state", "readinessSelector"],
      "properties": {
        "kind": { "const": "managedLoopbackHttp" },
        "pathAndQuery": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^/(?!/)(?!.*[#\\u0000-\\u001F\\u007F\\\\])(?!.*%(?:0[0-9A-Fa-f]|1[0-9A-Fa-f]|7[Ff]))[^#]*$"
        },
        "state": { "$ref": "#/$defs/token" },
        "readinessSelector": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "port", "startupTimeoutMs"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
          },
          "contains": {
            "type": "string",
            "pattern": "^(?:(?!\\{port\\})[\\s\\S])*\\{port\\}(?:(?!\\{port\\})[\\s\\S])*$"
          },
          "minContains": 1,
          "maxContains": 1
        },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "startupTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 180000 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewport", "deviceScaleFactor", "textScale", "locale", "timezoneId", "colorScheme", "reducedMotion"],
      "properties": {
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "unit"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "height": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "unit": { "const": "cssPixel" }
          }
        },
        "deviceScaleFactor": { "type": "number", "minimum": 1, "maximum": 2 },
        "textScale": { "enum": [1, 1.25] },
        "locale": { "enum": ["en-US", "ja-JP"] },
        "timezoneId": { "const": "UTC" },
        "colorScheme": { "const": "light" },
        "reducedMotion": { "const": "reduce" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessibleNameMode", "externalProcessing"],
      "properties": {
        "accessibleNameMode": { "const": "selectedNodes" },
        "externalProcessing": { "const": false }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "const": "sameOriginLoopback" } }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference"],
      "properties": { "reference": { "$ref": "#/$defs/repositoryPath" } }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "maxLength": 256 },
    "token": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 80 },
    "repositoryPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+$",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
