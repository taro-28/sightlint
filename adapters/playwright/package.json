{
  "name": "@sightlint/adapter-playwright",
  "version": "0.6.0",
  "private": true,
  "description": "Process-isolated Playwright acquisition and local check orchestration for SightLint",
  "type": "module",
  "bin": {
    "sightlint-web": "dist/src/cli.js",
    "sightlint-web-check": "dist/src/check-cli.js",
    "sightlint-interaction": "dist/src/interaction-cli.js"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && node --test dist/tests/unit.test.js",
    "install:browser": "playwright install chromium",
    "test:e2e": "npm run build && node --test dist/tests/e2e.test.js dist/tests/interaction-e2e.test.js dist/tests/segmentation-evaluation.test.js dist/tests/workflow-e2e.test.js && node --test dist/tests/perception-evaluation.test.js",
    "test:managed-e2e": "npm run build && node --test dist/tests/managed-e2e.test.js",
    "test:server-e2e": "npm run build && node --test dist/tests/server-e2e.test.js",
    "test:segmentation-evaluation": "npm run build && node --test dist/tests/segmentation-evaluation.test.js"
  },
  "dependencies": {
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  },
  "license": "MIT OR Apache-2.0"
}
