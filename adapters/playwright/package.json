{
  "name": "@sightlint/adapter-playwright",
  "version": "0.4.0",
  "private": true,
  "description": "Process-isolated Playwright acquisition and local check orchestration for SightLint",
  "type": "module",
  "bin": {
    "sightlint-web": "dist/src/cli.js",
    "sightlint-web-check": "dist/src/check-cli.js"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && node --test dist/tests/unit.test.js",
    "install:browser": "playwright install chromium",
    "test:e2e": "npm run build && node --test dist/tests/e2e.test.js dist/tests/workflow-e2e.test.js"
  },
  "dependencies": {
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  },
  "license": "UNLICENSED"
}
