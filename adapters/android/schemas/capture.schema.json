{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightlint:protocol:android-capture:0.1.0",
  "title": "SightLint instrumented Android capture 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["captureVersion", "captureId", "scenario", "application", "runner", "build", "device", "capture", "hierarchy", "screenshot"],
  "properties": {
    "captureVersion": { "const": "0.1.0" },
    "captureId": { "$ref": "#/$defs/token" },
    "scenario": { "enum": ["clean", "off-canvas-control-mutant", "scroll-offscreen-hard-negative"] },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "versionName", "versionCode"],
      "properties": {
        "packageName": { "const": "org.sightlint.fixtures.atlas" },
        "versionName": { "const": "0.1.0" },
        "versionCode": { "const": 1 }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "captureApi"],
      "properties": {
        "name": { "const": "sightlint-atlas-android-capture" },
        "version": { "const": "0.1.0" },
        "captureApi": { "const": "instrumentation-view-accessibility" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureSourceSha256", "gradleVersion", "androidGradlePluginVersion", "javaLanguageVersion", "compileSdk"],
      "properties": {
        "fixtureSourceSha256": { "$ref": "#/$defs/digest" },
        "gradleVersion": { "const": "8.13" },
        "androidGradlePluginVersion": { "const": "8.10.1" },
        "javaLanguageVersion": { "const": 17 },
        "compileSdk": { "const": 35 }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiLevel", "buildFingerprint", "manufacturer", "model", "device", "display", "configuration", "systemBarInsetsDevicePixels"],
      "properties": {
        "apiLevel": { "type": "integer", "minimum": 28, "maximum": 100 },
        "buildFingerprint": { "$ref": "#/$defs/nonEmptyString" },
        "manufacturer": { "$ref": "#/$defs/nonEmptyString" },
        "model": { "$ref": "#/$defs/nonEmptyString" },
        "device": { "$ref": "#/$defs/nonEmptyString" },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": ["widthPixels", "heightPixels", "densityDpi", "rotationDegrees"],
          "properties": {
            "widthPixels": { "type": "integer", "minimum": 1, "maximum": 32768 },
            "heightPixels": { "type": "integer", "minimum": 1, "maximum": 32768 },
            "densityDpi": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "rotationDegrees": { "enum": [0, 90, 180, 270] }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fontScale", "locale", "layoutDirection", "nightMode"],
          "properties": {
            "fontScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
            "locale": { "type": "string", "pattern": "^[A-Za-z0-9-]{2,35}$" },
            "layoutDirection": { "enum": ["ltr", "rtl"] },
            "nightMode": { "enum": ["light", "dark"] }
          }
        },
        "systemBarInsetsDevicePixels": { "$ref": "#/$defs/insets" }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "atomic", "animationsDisabled", "adbVersion", "emulatorVersion", "avdName", "instrumentationCommand", "limitations"],
      "properties": {
        "order": {
          "type": "array",
          "prefixItems": [
            { "const": "waitForIdle" },
            { "const": "viewAndAccessibilityHierarchy" },
            { "const": "screenshot" }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "atomic": { "const": false },
        "animationsDisabled": { "const": true },
        "adbVersion": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
        "emulatorVersion": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
        "avdName": { "$ref": "#/$defs/token" },
        "instrumentationCommand": { "$ref": "#/$defs/nonEmptyString" },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootResourceId", "unidentifiedNodeCount", "nodes"],
      "properties": {
        "rootResourceId": { "$ref": "#/$defs/resourceId" },
        "unidentifiedNodeCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "sha256", "widthPixels", "heightPixels", "captureSequence"],
      "properties": {
        "reference": { "$ref": "#/$defs/reference" },
        "sha256": { "$ref": "#/$defs/digest" },
        "widthPixels": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "heightPixels": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "captureSequence": { "const": 3 }
      }
    }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "nonEmptyString": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "reference": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\\\/].*" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resourceId": { "type": "string", "pattern": "^[A-Za-z0-9_.]+:id/[A-Za-z0-9_]+$", "maxLength": 256 },
    "nullableResourceId": { "anyOf": [{ "$ref": "#/$defs/resourceId" }, { "type": "null" }] },
    "nullableString": { "anyOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }] },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": -1048576, "maximum": 1048576 },
        "y": { "type": "integer", "minimum": -1048576, "maximum": 1048576 },
        "width": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "height": { "type": "integer", "minimum": 0, "maximum": 1048576 }
      }
    },
    "nullableRect": { "anyOf": [{ "$ref": "#/$defs/rect" }, { "type": "null" }] },
    "rawBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "integer", "minimum": -1048576, "maximum": 1048576 },
        "top": { "type": "integer", "minimum": -1048576, "maximum": 1048576 },
        "right": { "type": "integer", "minimum": -1048576, "maximum": 1048576 },
        "bottom": { "type": "integer", "minimum": -1048576, "maximum": 1048576 }
      }
    },
    "nullableRawBounds": { "anyOf": [{ "$ref": "#/$defs/rawBounds" }, { "type": "null" }] },
    "insets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "integer", "minimum": 0, "maximum": 32768 },
        "top": { "type": "integer", "minimum": 0, "maximum": 32768 },
        "right": { "type": "integer", "minimum": 0, "maximum": 32768 },
        "bottom": { "type": "integer", "minimum": 0, "maximum": 32768 }
      }
    },
    "stringFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utf8ByteLength", "sha256"],
      "properties": {
        "utf8ByteLength": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "nullableStringFact": { "anyOf": [{ "$ref": "#/$defs/stringFact" }, { "type": "null" }] },
    "viewState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shown", "enabled", "clickable", "focusable", "focused", "selected", "checkable", "checked", "scrollable", "longClickable"],
      "properties": {
        "shown": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "clickable": { "type": "boolean" },
        "focusable": { "type": "boolean" },
        "focused": { "type": "boolean" },
        "selected": { "type": "boolean" },
        "checkable": { "type": "boolean" },
        "checked": { "type": "boolean" },
        "scrollable": { "type": "boolean" },
        "longClickable": { "type": "boolean" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "packageName", "viewIdResourceName", "geometryStatus", "rawBoundsDevicePixels", "boundsDevicePixels", "actionIds", "enabled", "clickable", "focusable", "focused", "selected", "checkable", "checked", "scrollable", "longClickable", "visibleToUser"],
      "properties": {
        "className": { "$ref": "#/$defs/nullableString" },
        "packageName": { "$ref": "#/$defs/nullableString" },
        "viewIdResourceName": { "$ref": "#/$defs/nullableResourceId" },
        "geometryStatus": { "enum": ["exact", "invalidPlatformBounds", "unavailable"] },
        "rawBoundsDevicePixels": { "$ref": "#/$defs/nullableRawBounds" },
        "boundsDevicePixels": { "$ref": "#/$defs/nullableRect" },
        "actionIds": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
        },
        "enabled": { "type": "boolean" },
        "clickable": { "type": "boolean" },
        "focusable": { "type": "boolean" },
        "focused": { "type": "boolean" },
        "selected": { "type": "boolean" },
        "checkable": { "type": "boolean" },
        "checked": { "type": "boolean" },
        "scrollable": { "type": "boolean" },
        "longClickable": { "type": "boolean" },
        "visibleToUser": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "geometryStatus": { "const": "exact" } }, "required": ["geometryStatus"] },
          "then": {
            "properties": {
              "rawBoundsDevicePixels": { "$ref": "#/$defs/rawBounds" },
              "boundsDevicePixels": { "$ref": "#/$defs/rect" }
            }
          }
        },
        {
          "if": { "properties": { "geometryStatus": { "const": "invalidPlatformBounds" } }, "required": ["geometryStatus"] },
          "then": {
            "properties": {
              "rawBoundsDevicePixels": { "$ref": "#/$defs/rawBounds" },
              "boundsDevicePixels": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "geometryStatus": { "const": "unavailable" } }, "required": ["geometryStatus"] },
          "then": {
            "properties": {
              "rawBoundsDevicePixels": { "type": "null" },
              "boundsDevicePixels": { "type": "null" }
            }
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "parentResourceId", "depth", "className", "layoutBoundsDevicePixels", "identityTransform", "globalVisible", "viewState", "text", "contentDescription", "accessibility"],
      "properties": {
        "resourceId": { "$ref": "#/$defs/resourceId" },
        "parentResourceId": { "$ref": "#/$defs/nullableResourceId" },
        "depth": { "type": "integer", "minimum": 0, "maximum": 64 },
        "className": { "$ref": "#/$defs/nonEmptyString" },
        "layoutBoundsDevicePixels": { "$ref": "#/$defs/rect" },
        "identityTransform": { "type": "boolean" },
        "globalVisible": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "boundsDevicePixels"],
          "properties": {
            "value": { "type": "boolean" },
            "boundsDevicePixels": { "$ref": "#/$defs/nullableRect" }
          },
          "allOf": [
            {
              "if": { "properties": { "value": { "const": true } }, "required": ["value"] },
              "then": { "properties": { "boundsDevicePixels": { "$ref": "#/$defs/rect" } } }
            },
            {
              "if": { "properties": { "value": { "const": false } }, "required": ["value"] },
              "then": { "properties": { "boundsDevicePixels": { "type": "null" } } }
            }
          ]
        },
        "viewState": { "$ref": "#/$defs/viewState" },
        "text": { "$ref": "#/$defs/nullableStringFact" },
        "contentDescription": { "$ref": "#/$defs/nullableStringFact" },
        "accessibility": { "$ref": "#/$defs/accessibility" }
      }
    }
  }
}
