{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightlint:protocol:pptx-response:0.1.0",
  "title": "SightLint PPTX adapter response 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "status", "adapter", "inputSha256", "slideCount", "nodeCount", "renderCount", "coverage", "externalProcessing", "limitations"],
  "properties": {
    "protocolVersion": { "const": "0.1.0" },
    "requestId": { "$ref": "#/$defs/token" },
    "status": { "enum": ["complete", "partial"] },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "runtime"],
      "properties": {
        "name": { "const": "sightlint-pptx" },
        "version": { "const": "0.1.0" },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "python" },
            "version": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      }
    },
    "inputSha256": { "$ref": "#/$defs/digest" },
    "slideCount": { "type": "integer", "minimum": 1, "maximum": 100 },
    "nodeCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "renderCount": { "type": "integer", "minimum": 0, "maximum": 100 },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceGeometry", "sourceText", "renderedExtent", "renderedNodeIdentity"],
      "properties": {
        "sourceGeometry": { "enum": ["complete", "partial"] },
        "sourceText": { "const": "digestOnly" },
        "renderedExtent": { "enum": ["observed", "untested"] },
        "renderedNodeIdentity": { "const": "cantTell" }
      }
    },
    "externalProcessing": { "const": false },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
