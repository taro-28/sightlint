{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightlint:protocol:pdf-response:0.1.0",
  "title": "SightLint PDF adapter response 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "status", "adapter", "inputSha256", "pageCount", "nodeCount", "renderCount", "coverage", "externalProcessing", "limitations"],
  "properties": {
    "protocolVersion": { "const": "0.1.0" },
    "requestId": { "$ref": "#/$defs/token" },
    "status": { "const": "partial" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "runtime", "parser"],
      "properties": {
        "name": { "const": "sightlint-pdf" },
        "version": { "const": "0.1.0" },
        "runtime": { "$ref": "#/$defs/versionedRuntime" },
        "parser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "pypdf" },
            "version": { "const": "6.17.0" }
          }
        }
      }
    },
    "inputSha256": { "$ref": "#/$defs/digest" },
    "pageCount": { "type": "integer", "minimum": 1, "maximum": 100 },
    "nodeCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "renderCount": { "type": "integer", "minimum": 0, "maximum": 100 },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageGeometry", "linkAnnotations", "taggedStructure", "sourceText", "paintGeometry", "renderedExtent", "renderedNodeIdentity"],
      "properties": {
        "pageGeometry": { "const": "partial" },
        "linkAnnotations": { "const": "partial" },
        "taggedStructure": { "const": "untested" },
        "sourceText": { "const": "untested" },
        "paintGeometry": { "const": "untested" },
        "renderedExtent": { "enum": ["observed", "partial", "untested"] },
        "renderedNodeIdentity": { "const": "cantTell" }
      }
    },
    "externalProcessing": { "const": false },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "versionedRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "python" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    }
  }
}
